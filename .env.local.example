# ─────────────────────────────────────────────────────────────────────────────
# SETUP GUIDE
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. FIREBASE PROJECT
#    a. Go to https://console.firebase.google.com → New Project
#    b. Enable Authentication → Sign-in method → Google
#       - Under "Authorized domains" add your Vercel domain later
#    c. Enable Firestore Database (start in production mode)
#    d. Add a Web App → copy the config values below
#    e. Project Settings → Service accounts → Generate new private key
#       - Save the JSON, then run: base64 -i service-account.json | tr -d '\n'
#       - Paste the output as FIREBASE_SERVICE_ACCOUNT_BASE64
#
# 2. GOOGLE CLOUD (same project as Firebase)
#    a. Go to https://console.cloud.google.com → select your Firebase project
#    b. APIs & Services → Enable: Google Sheets API, Google Drive API
#    c. Use the SAME service account JSON from step 1e above
#       - That service account is already in your GCP project
#       - GOOGLE_SERVICE_ACCOUNT_BASE64 can be the same value as FIREBASE_SERVICE_ACCOUNT_BASE64
#
# 3. RESTRICT SIGN-INS TO YOUR SCHOOL DOMAIN (optional but recommended)
#    Set NEXT_PUBLIC_ALLOWED_DOMAIN to your school's Google Workspace domain
#
# ─────────────────────────────────────────────────────────────────────────────

# Firebase (client-side — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side only — keep secret)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Google Sheets + Drive API (server-side only — keep secret)
# Can be the same value as FIREBASE_SERVICE_ACCOUNT_BASE64
GOOGLE_SERVICE_ACCOUNT_BASE64=

# Your deployed app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of admin email addresses
ADMIN_EMAILS=you@school.edu

# Optional: only allow sign-ins from this Google Workspace domain
# Leave blank to allow any Google account
NEXT_PUBLIC_ALLOWED_DOMAIN=school.edu
